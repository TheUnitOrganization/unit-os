#!/usr/bin/env bash
# Spawn a coding agent as a kitty TAB in the window you are already looking
# at, so several agents stack up in one place and Alt+1..9 switches between
# them. Falls back to a new kitty window when the focused window is not a
# kitty (or when remote control is not up yet).
#
#   agent            claude, new tab, same directory as the focused tab
#   agent -w         claude, new window
#   agent opencode   any other harness by name
#
# Why a script and not a plain `kitty --tab`: kitty has no way to say "add a
# tab to whichever instance is focused" from outside. Each instance listens
# on unix:@mykitty-<pid> (see kitty.conf), so this looks the pid up from
# Hyprland and talks to that socket.
set -uo pipefail

new_window=0
[ "${1:-}" = "-w" ] && { new_window=1; shift; }

harness="${1:-claude}"
shift 2>/dev/null || true
command -v "$harness" >/dev/null || { notify-send "agent" "$harness not found"; exit 1; }

# Tab title: the project directory, so a row of tabs reads as a row of
# projects rather than five identical "claude"s.
title() { printf '%s %s' "$1" "$(basename "${2:-$HOME}")"; }

if [ "$new_window" -eq 0 ]; then
    read -r pid class < <(hyprctl activewindow -j 2>/dev/null \
        | jq -r '"\(.pid) \(.class)"' 2>/dev/null)
    if [ "${class:-}" = "kitty" ] && [ -n "${pid:-}" ]; then
        sock="unix:@mykitty-$pid"
        # --cwd=current inherits the directory of the tab you are in, which
        # is the whole point: the new agent starts where you are working.
        if kitten @ --to "$sock" launch --type=tab --cwd=current \
              --tab-title "$harness" "$harness" "$@" >/dev/null 2>&1; then
            exit 0
        fi
    fi
fi

exec kitty --title "$(title "$harness" "$PWD")" -e "$harness" "$@"
