#!/usr/bin/env bash
#
# setup-grub -- replace the centred systemd-boot menu with a plain list at
# the top left: two entries, Geist Mono, black, nothing else on the screen.
#
#   sudo ~/.local/bin/setup-grub                 apply
#   sudo ~/.local/bin/setup-grub --font-size 44  bigger text, re-run any time
#   sudo ~/.local/bin/setup-grub --revert        back to systemd-boot
#
# Why GRUB at all: systemd-boot centres its entry list in the code and there
# is no setting for it.
#
# Why a THEME and not GRUB's normal text menu: the text menu is not simple.
# It prints "GNU GRUB version 2.14" across the top, draws a bordered box
# sized to the terminal (so two entries sit in a mostly empty frame), and
# adds three lines of help underneath. A gfxmenu theme draws only what it is
# told to -- here, two lines at the top left. If the theme ever fails to
# load, GRUB falls back to that text menu on its own and still boots.
#
# What it does NOT do: touch systemd-boot. /boot/loader/ is left exactly as
# it is, so --revert is only a change of NVRAM boot order -- the old
# bootloader is still on the ESP, working, one firmware menu away.
#
# grub.cfg here is HAND-WRITTEN, not generated by grub-mkconfig, so that the
# menu is exactly two lines. The cost: a NEW KERNEL (linux-lts, linux-zen)
# will not appear on its own -- add a menuentry below by hand. Ordinary
# linux updates are fine, the file names never change.
#
set -euo pipefail

ESP=/boot
ESP_UUID=BC00-2BE2                                      # nvme0n1p1, the EFI partition
ROOT_PARTUUID=56b896c5-f00e-4a31-bfa4-523ad38bb115      # nvme0n1p6, btrfs @
FONT_SRC=/usr/share/fonts/TTF/GeistMono-Regular.ttf
FONT_SIZE=36
TIMEOUT=3
THEME_DIR="$ESP/grub/themes/unit"

# quiet + loglevel=3 cut the kernel log scroll to a couple of lines;
# vt.global_cursor_default=0 stops the blinking cursor, so the gap between
# the menu and hyprlock is just black. Everything before `quiet` is this
# machine's existing command line, copied verbatim from /proc/cmdline.
CMDLINE="root=PARTUUID=$ROOT_PARTUUID rw rootfstype=btrfs rootflags=subvol=@ zswap.enabled=0 quiet loglevel=3 vt.global_cursor_default=0"

[[ $EUID -eq 0 ]] || { echo "run me with sudo -- and with the full path, sudo's secure_path drops ~/.local/bin"; exit 1; }

# ---------------------------------------------------------------- revert ---
if [[ "${1:-}" == "--revert" ]]; then
    echo ":: removing the GRUB firmware entry (files stay on the ESP)"
    while read -r num; do
        echo "   deleting Boot$num"
        efibootmgr -b "$num" -B >/dev/null
    done < <(efibootmgr | sed -nE 's/^Boot([0-9A-F]{4})\*? +GRUB$/\1/p')

    sd=$(efibootmgr | sed -nE 's/^Boot([0-9A-F]{4})\*? +Linux Boot Manager$/\1/p' | head -1)
    if [[ -n $sd ]]; then
        rest=$(efibootmgr | sed -nE 's/^BootOrder: (.*)$/\1/p' | tr ',' '\n' | grep -v "^$sd$" | paste -sd,)
        efibootmgr -o "$sd${rest:+,$rest}" >/dev/null
        echo "   systemd-boot (Boot$sd) is first in BootOrder again"
    else
        echo "   !! no 'Linux Boot Manager' entry found -- check efibootmgr by hand before rebooting"
    fi
    echo
    echo "Reverted. systemd-boot's own config was never touched, so the old"
    echo "menu comes back exactly as it was. To also reclaim the disk space:"
    echo "   pacman -Rns grub && rm -rf $ESP/grub $ESP/EFI/GRUB"
    exit 0
fi

[[ "${1:-}" == "--font-size" ]] && FONT_SIZE=${2:?--font-size needs a number}

# ----------------------------------------------------------------- apply ---
echo ":: 1/5  grub"
pacman -S --needed --noconfirm grub

echo ":: 2/5  firmware entry"
# Puts grubx64.efi + modules on the ESP and adds an NVRAM entry named GRUB,
# first in BootOrder. systemd-boot's entry survives underneath it.
grub-install --target=x86_64-efi --efi-directory="$ESP" --bootloader-id=GRUB --recheck

echo ":: 3/5  font (Geist Mono ${FONT_SIZE}px)"
# The panel is 2880x1620, so the firmware's stock text font renders tiny --
# that was half the original complaint. A real font at native resolution is
# crisp rather than upscaled.
install -d "$ESP/grub/fonts"
grub-mkfont -s "$FONT_SIZE" -o "$ESP/grub/fonts/menu.pf2" "$FONT_SRC"
[[ -f /usr/share/grub/unicode.pf2 ]] && install -m644 /usr/share/grub/unicode.pf2 "$ESP/grub/fonts/"

# A theme references a font by the name baked into the .pf2, not by file
# name, and grub-mkfont composes that name itself. Guessing it wrong makes
# the menu silently fall back to the tiny default, so read it back out of
# the file instead of hardcoding it.
FONT_NAME=$(python3 - "$ESP/grub/fonts/menu.pf2" <<'PY'
import struct, sys
d = open(sys.argv[1], 'rb').read()
i = 0
while i + 8 <= len(d):
    tag = d[i:i+4]; n = struct.unpack('>I', d[i+4:i+8])[0]; i += 8
    if tag == b'NAME':
        print(d[i:i+n].rstrip(b'\0').decode('utf-8', 'replace')); break
    if tag == b'DATA': break
    i += n
PY
)
[[ -n $FONT_NAME ]] || { echo "   !! could not read the font name out of menu.pf2"; exit 1; }
echo "   font name: $FONT_NAME"

echo ":: 4/5  theme -> $THEME_DIR"
install -d "$THEME_DIR"
cat > "$THEME_DIR/theme.txt" <<EOF
# Unit -- written by setup-grub.
# Deliberately empty except for the list: no title, no border, no help text.

title-text: ""
desktop-color: "#000000"
terminal-font: "$FONT_NAME"

+ boot_menu {
    left  = 8%
    top   = 8%
    width = 60%
    height = 60%

    item_font            = "$FONT_NAME"
    item_color           = "#595959"
    selected_item_color  = "#ffffff"
    item_height          = $((FONT_SIZE + 26))
    item_spacing         = 10
    item_padding         = 0

    # No icon files ship with this theme; leaving the icon box at its
    # default width would indent every label by an empty gap.
    icon_width      = 0
    icon_height     = 0
    item_icon_space = 0

    scrollbar = false
}

# The countdown. GRUB fills %d with the seconds left and hides the label the
# moment any key is pressed, so its disappearing is also the "I heard you".
+ label {
    id    = "__timeout__"
    left  = 8%
    top   = 20%
    width = 60%
    align = "left"
    font  = "$FONT_NAME"
    color = "#595959"
    text  = "boots in %d"
}
EOF
sed 's/^/   /' "$THEME_DIR/theme.txt"

echo ":: 5/5  grub.cfg"
[[ -e "$ESP/grub/grub.cfg" && ! -e "$ESP/grub/grub.cfg.pre-setup-grub" ]] && \
    cp -a "$ESP/grub/grub.cfg" "$ESP/grub/grub.cfg.pre-setup-grub"
cat > "$ESP/grub/grub.cfg" <<EOF
# Written by setup-grub. Hand-maintained -- grub-mkconfig would overwrite it
# and put the "Advanced options" submenu back.

insmod all_video
insmod gfxterm
insmod gfxmenu
insmod part_gpt
insmod fat
insmod chain

set gfxmode=auto
set gfxpayload=keep

# unicode.pf2 first so it stays the fallback for any glyph menu.pf2 lacks;
# GRUB searches every loaded font before giving up on a character.
loadfont \$prefix/fonts/unicode.pf2
loadfont \$prefix/fonts/menu.pf2
terminal_output gfxterm
# Once a menuentry runs, the theme is gone and echo writes to the plain
# gfxterm -- pin that to the same font so the hand-off line matches the menu.
set gfxterm_font="$FONT_NAME"

set theme=\$prefix/themes/unit/theme.txt
export theme

set default=0
set timeout=$TIMEOUT
set timeout_style=menu

# The echo is the only feedback that ENTER did anything: with quiet on the
# kernel line, the screen would otherwise sit black until hyprlock. It stays
# up while the kernel + initrd are read (gfxpayload=keep, no clear).
menuentry "Arch Linux" {
    search --no-floppy --fs-uuid --set=root $ESP_UUID
    echo
    echo "  > Arch Linux"
    linux  /vmlinuz-linux $CMDLINE
    initrd /initramfs-linux.img
}

menuentry "Windows" {
    search --no-floppy --fs-uuid --set=root $ESP_UUID
    echo
    echo "  > Windows"
    chainloader /EFI/Microsoft/Boot/bootmgfw.efi
}
EOF
sed 's/^/   /' "$ESP/grub/grub.cfg"

cat <<'EOF'

done. Reboot to see it.

  keys               up/down to move, ENTER to boot (space only stops the
                     countdown); the "boots in N" line vanishes on any key
  text too small     sudo ~/.local/bin/setup-grub --font-size 48
  recovery kernel    press 'e' on the Arch entry, change initramfs-linux.img
                     to initramfs-linux-fallback.img, then Ctrl+X
  if GRUB is broken  the firmware boot menu (F2/F7/F12 at power-on) still
                     lists "Linux Boot Manager" -- that is systemd-boot,
                     untouched and still working
  undo               sudo ~/.local/bin/setup-grub --revert
EOF
