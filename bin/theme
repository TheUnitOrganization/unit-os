/* Message-dialog buttons. Adwaita welds the action area into one bar: the
   buttons are square, edge-to-edge, and separated by 1px hairlines. Read
   quickly that looks like two of the three buttons are highlighted, because
   the only thing carrying a visible border is whichever pair happens to sit
   next to a divider. Here the border is spent on state instead -- transparent
   at rest, gold on hover, muted on keyboard focus -- and the buttons are
   spaced apart so the grouping comes from the gaps, not from a frame. */
messagedialog .dialog-action-area,
dialog .dialog-action-area {{
  padding: 12px;
  border-spacing: 12px;                    /* the gap between the buttons */
  background-color: transparent;
  border-top: none;
}}

messagedialog .dialog-action-area > button,
dialog .dialog-action-area > button {{
  background-color: @surface0;
  border: 1px solid transparent;
  border-radius: {R['sm']}px;
  padding: 12px 24px;
  min-height: 26px;
  margin: 0;
  box-shadow: none;
  outline: none;                           /* kills the dotted focus ring */
}}

messagedialog .dialog-action-area > button:hover,
dialog .dialog-action-area > button:hover {{
  background-color: @surface1;
  border-color: @gold;
}}

/* Keyboard focus and the default action still need to be findable without
   the mouse, but quieter than hover so the two never compete. */
messagedialog .dialog-action-area > button:focus,
dialog .dialog-action-area > button:focus,
messagedialog .dialog-action-area > button.suggested-action,
dialog .dialog-action-area > button.suggested-action {{
  border-color: @borders;
}}

messagedialog .dialog-action-area > button:active,
dialog .dialog-action-area > button:active {{
  background-color: @surface1;
  border-color: @gold;
}}

/* The dialog body itself was cramped against its own edges. */
messagedialog .message-area,
messagedialog box.vertical > box.vertical {{
  padding: 8px 12px;
}}
"""
    write(CFG / "gtk-3.0" / "gtk.css", css)
    write(CFG / "gtk-4.0" / "gtk.css", css)


def render_gtk_settings(p):
    """The base theme and the icon set, which gtk.css cannot express.

    Adwaita vs Adwaita-dark decides what every widget gtk.css does not name
    falls back to, so a light palette on top of Adwaita-dark leaves black
    holes in Thunar. `reload` mirrors these into gsettings for GTK4."""
    ini = f"""[Settings]
gtk-theme-name={p['gtk_theme']}
gtk-application-prefer-dark-theme={p['prefer_dark']}
gtk-icon-theme-name={p['icons']}
gtk-font-name=Cantarell 11
gtk-cursor-theme-size=24
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintslight
gtk-xft-rgba=rgb
"""
    write(CFG / "gtk-3.0" / "settings.ini", ini)
    write(CFG / "gtk-4.0" / "settings.ini", ini)


def render_nvim(p):
    write(CFG / "nvim" / "lua" / "theme.lua", f"""-- generated by `theme` -- do not edit by hand
return {{ colorscheme = "{p['nvim']}", background = "dark" }}
""")


def render_hyprlock(p):
    """hyprlock reads its config at launch, so nothing to reload."""
    img = pinned() or LOCK_IMAGE
    if img.is_file():
        background = f"""background {{
    monitor =
    path = {img}
    blur_passes = 3
    blur_size = 6
    brightness = 0.55
}}"""
    else:
        background = f"""background {{
    monitor =
    color = {p['base']}
}}"""
    write(CFG / "hypr" / "hyprlock.conf", f"""# generated by `theme` -- do not edit by hand
# Layout from the shipped sample at /usr/share/hypr/hyprlock.conf.

$font = JetBrainsMono Nerd Font

general {{
    hide_cursor = true
}}

animations {{
    enabled = true
    bezier = linear, 1, 1, 0, 0
    animation = fadeIn, 1, 5, linear
    animation = fadeOut, 1, 5, linear
    animation = inputFieldDots, 1, 2, linear
}}

{background}

input-field {{
    monitor =
    size = 18%, 5%
    outline_thickness = 2
    rounding = {radii(p)['xs'] // 2}

    inner_color = {hypr_rgba(p['base'], 'ff')}
    outer_color = {hypr_rgba(p['accent'], 'ff')}
    check_color = {hypr_rgba(p['accent2'], 'ff')}
    fail_color  = {hypr_rgba(p['crit'], 'ff')}

    font_color        = {hypr_rgba(p['text'], 'ff')}
    placeholder_color = {hypr_rgba(p['muted'], 'b3')}
    font_family       = $font

    placeholder_text = Password
    fail_text        = $PAMFAIL
    fade_on_empty    = false
    dots_spacing     = 0.3

    position = 0, -40
    halign = center
    valign = center
}}

# TIME
label {{
    monitor =
    text = $TIME
    font_size = 92
    font_family = $font
    color = {hypr_rgba(p['text'], 'ff')}

    position = 0, 180
    halign = center
    valign = center
}}

# DATE
label {{
    monitor =
    text = cmd[update:60000] date +"%A, %d %B %Y"
    font_size = 18
    font_family = $font
    color = {hypr_rgba(p['accent'], 'ff')}

    position = 0, 110
    halign = center
    valign = center
}}
""")


# --------------------------------------------------------------------------
def reload(name, p):
    def run(*cmd, **kw):
        try:
            subprocess.run(cmd, check=False,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, **kw)
        except FileNotFoundError:
            pass

    # The folder-colour variant is a thin theme in $HOME (see
    # `papirus-variant`); build it on first use of a theme, after a
    # papirus-icon-theme update has wiped it, and whenever the recipe below
    # changes -- the theme stamps its inputs into `.recipe` so we can tell.
    icons = HOME / ".local/share/icons" / p["icons"]
    if "icons_src" in p:
        base, color = p["icons_src"]
        pairs = [f"{k}={v}" for k, v in sorted(FOLDER_HUES.items())]
        want = f"{base} {color} {' '.join(pairs)}".strip() + "\n"
        stamp = icons / ".recipe"
        if not icons.is_dir() or not stamp.exists() or stamp.read_text() != want:
            run(str(HOME / ".local/bin/papirus-variant"),
                p["icons"], base, color, *pairs)

    # GTK4/libadwaita apps read gsettings, not settings.ini.
    for key, val in (("gtk-theme", p["gtk_theme"]),
                     ("icon-theme", p["icons"]),
                     ("color-scheme", p["color_scheme"])):
        run("gsettings", "set", "org.gnome.desktop.interface", key, val)

    # Thunar only reads settings.ini and gtk.css at startup, and it keeps a
    # daemon alive after the last window closes.
    run("thunar", "-q")

    run("pkill", "waybar")
    env = dict(os.environ)
    subprocess.Popen(["waybar"], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True, env=env)

    run("pkill", "dunst")
    subprocess.Popen(["dunst"], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True, env=env)

    run("hyprctl", "reload")

    # hyprpaper only reads its config at start.
    run("pkill", "-x", "hyprpaper")
    subprocess.Popen(["hyprpaper"], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True, env=env)

    # Live-recolour every running kitty without restarting it.
    colors = str(CFG / "kitty" / "colors.conf")
    run("kitten", "@", "--to", os.environ.get("KITTY_LISTEN_ON", ""),
        "set-colors", "--all", "--configured", colors)

    run("notify-send", "Theme", f"Switched to {name}")


def main():
    args = sys.argv[1:]
    family = read_state()

    if not args or args[0] in ("-h", "--help"):
        print(f"current: {family}\n")
        print("available:")
        for k, v in FAMILIES.items():
            mark = "*" if k == family else " "
            print(f"  {mark} {k:<9} {v['label']}")
        print("\nusage: theme <name>")
        return 0

    name = ALIASES.get(args[0], args[0])
    if name not in FAMILIES:
        print(f"unknown theme: {args[0]}", file=sys.stderr)
        print("available: " + ", ".join(FAMILIES), file=sys.stderr)
        return 1
    family = name

    p = palette(family)
    for fn in (render_waybar, render_kitty, render_alacritty, render_rofi,
               render_dunst, render_hypr, render_starship, render_gtk,
               render_gtk_settings, render_nvim, render_wallpaper):
        fn(p)
    render_hyprlock(p)

    write(STATE, family + "\n")
    reload(family, p)
    print(f"theme -> {family} ({p['label']})")
    print("open a new shell for the prompt, and a new terminal for full effect")
    return 0


if __name__ == "__main__":
    sys.exit(main())
