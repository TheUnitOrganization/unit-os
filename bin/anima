#!/usr/bin/env python3
"""
anima -- roll a random robot in the ANIMA house style and render it.

The style is fixed (that is the point): matte grey panels, dark joints, one
amber light bar, a small "unit" label, seamless studio backdrop, product-shot
lighting. What varies is the machine itself -- legs or wheels, body shape,
sensor mast, extras, pose -- and a serial in the JJVV-nn rhythm (never JJVV
itself -- that name is reserved).

  anima                      one roll on the good model, on-white/on-black per theme
  anima --draft              cheapest model (ignores framing -- robot fills the frame)
  anima --seed 42            reproduce a roll (same seed = same spec + prompt)
  anima --show               generate, then put it on screen (not pinned)
  anima --pin                generate, then pin it as the wallpaper for good
  anima --dry                print the spec + prompt, spend nothing
  anima --black / --white    force the backdrop
  anima --upscale            2x via Real-ESRGAN after the render (~$0.002)

Costs (Replicate, approx): schnell $0.003, dev $0.025, pro $0.04 per image.
Token comes from ~/.config/ai-usage/env (REPLICATE_API_TOKEN). Output lands
in ~/Pictures/anima/gen/<stamp>-<serial>.png with a .txt beside it holding
the seed, spec and prompt, so any roll can be re-rolled or tweaked.
"""
import argparse, json, os, random, subprocess, sys, time, urllib.request
from datetime import datetime
from pathlib import Path

HOME = Path.home()
OUT = HOME / "Pictures" / "anima" / "gen"
ENV = HOME / ".config" / "ai-usage" / "env"
PIN = HOME / ".config" / "themes" / "wallpaper"
FONT = "Geist Mono"

MODELS = {
    "schnell": "black-forest-labs/flux-schnell",
    "dev":     "black-forest-labs/flux-dev",
    "pro":     "black-forest-labs/flux-1.1-pro",
}
UPSCALER = "nightmareai/real-esrgan"

# ---------------------------------------------------------------- the dice --
# Each list is (weight, phrase). Weights lean toward the reference render --
# four legs, slab body -- so most rolls read as siblings of the wallpaper and
# the odd one is a cousin.
LOCOMOTION = [
    (5, "four long articulated legs with dark hydraulic joints and small rubber feet"),
    (3, "four legs ending in wheel-feet, wheel-leg hybrid"),
    (2, "six slender articulated legs, insect-like stance"),
    (2, "two thick legs and a counterbalancing tail, digitigrade"),
    (1, "four stubby legs with rubber tracks instead of feet"),
    (1, "three legs, tripod stance"),
]
BODY = [
    (5, "a low rectangular slab chassis with rounded panel edges"),
    (2, "a tall narrow cabinet-like body"),
    (2, "a segmented body of two hinged modules"),
    (1, "a flat sled-like platform body"),
    (1, "a wedge-shaped body, thicker at the rear"),
]
HEAD = [
    (4, "no head, just the amber light bar on the front panel"),
    (3, "a small pan-tilt sensor pod on a short mast"),
    (2, "a lidar puck on top"),
    (1, "a periscope camera raised on a thin stalk"),
]
EXTRA = [
    (4, "two thin whip antennas"),
    (2, "a single tall whip antenna"),
    (2, "a folded manipulator arm tucked under the body"),
    (1, "a cargo rack with tie-down rails on top"),
    (1, "a winch drum on the front"),
    (1, "a small folded solar panel on top"),
    (2, "nothing else"),
]
POSE = [
    (5, "standing still, three-quarter front view"),
    (2, "side profile, standing"),
    (2, "front view, standing square"),
    (1, "mid-stride, one leg lifted"),
    (1, "crouched low, legs folded"),
]

def pick(rng, table):
    return rng.choices([p for _, p in table], weights=[w for w, _ in table])[0]

def serial(rng):
    """Same rhythm as JJVV-nn -- two doubled letters, a dash, two digits --
    but JJVV itself is reserved for something bigger and never rolls."""
    while True:
        a, b = rng.sample("ABCDEFGHKLMNPRSTUVWXYZ", 2)   # no I/O/Q/J: stencil-safe
        if a + b != "JV":
            return f"{a}{a}{b}{b}-{rng.randrange(100):02d}"

def roll(seed):
    rng = random.Random(seed)
    return {
        "serial":     serial(rng),
        "locomotion": pick(rng, LOCOMOTION),
        "body":       pick(rng, BODY),
        "head":       pick(rng, HEAD),
        "extra":      pick(rng, EXTRA),
        "pose":       pick(rng, POSE),
    }

def prompt(spec, backdrop):
    bg = ("seamless pure white studio backdrop, soft grey floor reflection"
          if backdrop == "white" else
          "seamless pure black studio backdrop, faint floor reflection")
    return (
        f"product photograph of an autonomous robot, {spec['body']}, "
        f"{spec['locomotion']}, {spec['head']}, {spec['extra']}. "
        "matte light grey armored panels with subtle panel lines, dark gunmetal "
        "mechanical joints and actuators, a single horizontal amber light bar "
        "glowing on the front panel, a small printed 'unit' label, "
        f"small stencilled marking '{spec['serial']}' on the side. "
        f"{spec['pose']}. wide shot from a distance: the robot is small in the "
        "frame, about a third of the width, centered, with a large amount of "
        f"empty backdrop above and around it. {bg}, soft diffused studio lighting, "
        "photoreal industrial design render, hard-surface, ultra detailed, "
        "clean, no text other than the labels, no people"
    )

# ------------------------------------------------------------- replicate ---
def token():
    if "REPLICATE_API_TOKEN" in os.environ:
        return os.environ["REPLICATE_API_TOKEN"]
    for line in ENV.read_text().splitlines():
        if line.startswith("REPLICATE_API_TOKEN="):
            return line.split("=", 1)[1].strip().strip('"').strip("'")
    sys.exit(f"no REPLICATE_API_TOKEN in {ENV}")

def api(path, body=None):
    req = urllib.request.Request(
        "https://api.replicate.com/v1" + path,
        data=json.dumps(body).encode() if body is not None else None,
        headers={"Authorization": f"Bearer {token()}",
                 "Content-Type": "application/json"},
        method="POST" if body is not None else "GET")
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.load(r)

def finish(pred):
    while pred["status"] not in ("succeeded", "failed", "canceled"):
        time.sleep(2)
        pred = api(f"/predictions/{pred['id']}")
    if pred["status"] != "succeeded":
        sys.exit(f"replicate {pred['status']}: {pred.get('error')}")
    out = pred["output"]
    return out[0] if isinstance(out, list) else out

def fetch(url, dest):
    with urllib.request.urlopen(url, timeout=120) as r, open(dest, "wb") as f:
        f.write(r.read())

def render(model, text, seed):
    inp = {"prompt": text, "aspect_ratio": "16:9", "output_format": "png", "seed": seed}
    if model == "pro":
        inp.update(width=1440, height=810, prompt_upsampling=False, safety_tolerance=2)
    else:
        inp.update(megapixels="1", num_outputs=1, go_fast=False)
    return finish(api(f"/models/{MODELS[model]}/predictions", {"input": inp}))

def upscale(png):
    with open(png, "rb") as f:
        import base64
        data = "data:image/png;base64," + base64.b64encode(f.read()).decode()
    return finish(api(f"/models/{UPSCALER}/predictions",
                      {"input": {"image": data, "scale": 2, "face_enhance": False}}))

# -------------------------------------------------------------- wordmark ---
def size_of(png):
    import struct
    with open(png, "rb") as f:
        head = f.read(24)
    return struct.unpack(">II", head[16:24])

def wordmark(src, dst, backdrop):
    w, h = size_of(src)
    colour = "#8a8a8a" if backdrop == "white" else "#6a6a6a"
    fs = round(h * 0.0135)          # 22px at 1620
    x, y = round(w * 0.035), round(h * 0.935)
    svg = f"""<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
  width="{w}" height="{h}" viewBox="0 0 {w} {h}">
  <image xlink:href="{src.name}" width="{w}" height="{h}"/>
  <text x="{x}" y="{y}" font-family="{FONT}" font-size="{fs}" letter-spacing="{fs*0.42:.1f}"
        fill="{colour}">THE UNIT ORGANIZATION</text>
</svg>"""
    # rsvg refuses external files from an SVG on stdin; a sibling .svg with
    # a relative href is inside its allowed base directory.
    svgf = src.with_suffix(".svg")
    svgf.write_text(svg)
    subprocess.run(["rsvg-convert", "--unlimited", "-o", str(dst), str(svgf)], check=True)
    svgf.unlink()

# ----------------------------------------------------------------- main ----
def current_backdrop():
    fam = (HOME / ".config" / "themes" / "current").read_text().strip() \
        if (HOME / ".config" / "themes" / "current").exists() else "terminal"
    return "black" if fam == "terminal" else "white"

def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--seed", type=int)
    ap.add_argument("--draft", action="store_true")
    ap.add_argument("--dev", action="store_true")
    ap.add_argument("--dry", action="store_true")
    ap.add_argument("--show", action="store_true")
    ap.add_argument("--pin", action="store_true")
    ap.add_argument("--upscale", action="store_true")
    ap.add_argument("--black", action="store_true")
    ap.add_argument("--white", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    a = ap.parse_args()
    if a.help:
        print(__doc__.strip()); return

    seed = a.seed if a.seed is not None else random.randrange(1 << 31)
    backdrop = "black" if a.black else "white" if a.white else current_backdrop()
    model = "schnell" if a.draft else "dev" if a.dev else "pro"
    spec = roll(seed)
    text = prompt(spec, backdrop)

    print(f":: seed {seed}  model {model}  backdrop {backdrop}")
    for k, v in spec.items():
        print(f"   {k:<10} {v}")
    if a.dry:
        print(); print(text); return

    OUT.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    base = OUT / f"{stamp}-{spec['serial']}"
    raw, final = base.with_suffix(".raw.png"), base.with_suffix(".png")

    print(":: rendering")
    fetch(render(model, text, seed), raw)
    if a.upscale:
        print(":: upscaling 2x")
        fetch(upscale(raw), raw)
    wordmark(raw, final, backdrop)
    raw.unlink()
    base.with_suffix(".txt").write_text(
        f"seed {seed}\nmodel {model}\nbackdrop {backdrop}\n"
        + "".join(f"{k} {v}\n" for k, v in spec.items()) + f"\n{text}\n")
    print(f":: {final}")

    if a.show or a.pin:
        subprocess.run(["hyprctl", "hyprpaper", "reload", f",{final}"],
                       stdout=subprocess.DEVNULL)
    if a.pin:
        PIN.write_text(f"# one absolute path = every theme, both sides\n{final}\n")
        print(f":: pinned in {PIN}")

if __name__ == "__main__":
    main()
