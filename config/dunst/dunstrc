# generated by `theme` -- do not edit by hand
[global]
    monitor = 0
    follow = mouse
    # Wide enough that the AI usage table (bars + "resets in 1h 56m") fits
    # on one line each. Notifications still shrink to their content.
    width = (250, 680)
    height = (0, 300)
    origin = top-right
    # dunst is a layer-shell surface, so it is already placed below the
    # bar's exclusive zone (waybar: 10px margin + 48px tall = 58). The
    # offset is on top of that, and 16 on both axes is Hyprland's gaps_out
    # (~/.config/hypr/looks.lua): the notification's top and right edges
    # line up exactly with the window below it. (62 here put it 120px down.)
    offset = (16, 16)
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1

    # Same glass as the bar: 55% opaque over a blurred layer (the blur is a
    # layer rule on "notifications" in ~/.config/hypr/rules.lua).
    transparency = 45
    separator_height = 2
    padding = 16
    horizontal_padding = 18
    frame_width = 1
    # Square for `terminal`, soft for `studio`. The layer rule in
    # ~/.config/hypr/rules.lua sets ignore_alpha, so the rounded corners
    # are really transparent rather than a square of blurred backdrop.
    corner_radius = 0
    progress_bar_corner_radius = 0
    gap_size = 8

    font = JetBrainsMono Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    stack_duplicates = true
    show_indicators = no

    enable_recursive_icon_lookup = true
    icon_theme = "Papirus-Terminal"
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/brave
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background = "#000000"
    foreground = "#8f8f8f"
    frame_color = "#1a1a1a"
    timeout = 5

[urgency_normal]
    background = "#000000"
    foreground = "#e0e0e0"
    # The focused-window border in ~/.config/hypr/colors.lua is a 45 degree
    # sweep from `accent` into `surface1`, which is why a selected terminal
    # reads as edged rather than outlined. dunst takes one flat colour, so
    # this is that gradient flattened to its midpoint: the same two ends,
    # no hard off-white ring. Push the third argument toward 0 for more
    # presence, toward 1 to fade the frame into the low-urgency grey.
    frame_color = "#7d7d7d"
    timeout = 8

[urgency_critical]
    background = "#000000"
    foreground = "#ff4444"
    frame_color = "#ff4444"
    timeout = 0

# The AI usage popup is a table, not a message -- it does not need a title
# repeating what the pill already says. Body only.
[ai-usage]
    appname = "AI usage"
    format = "%b"
