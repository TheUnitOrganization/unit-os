/* generated by `theme` -- do not edit by hand */
* {
    base:     #000000;
    mantle:   #000000;
    surface0: #0d0d0d;
    surface1: #1a1a1a;
    text:     #e0e0e0;
    subtext:  #8f8f8f;

    background-color: transparent;
    text-color:       @text;
}

window {
    transparency:     "real";
    background-color: @base;
    border:           1px;
    border-color:     rgba(224, 224, 224, 0.28);
    border-radius:    0px;
    width:            420px;
    padding:          14px;
    location:         center;
    anchor:           center;
}

mainbox { spacing: 10px; children: [ inputbar, listview ]; }

inputbar {
    background-color: @mantle;
    border:           1px;
    border-color:     rgba(224, 224, 224, 0.22);
    border-radius:    0px;
    padding:          10px 12px;
    spacing:          8px;
    children:         [ entry ];
}

entry { placeholder: "Go..."; placeholder-color: @subtext; cursor: text; }

listview {
    lines: 10; columns: 1; scrollbar: false;
    spacing: 2px; fixed-height: true; dynamic: false;
}

element { padding: 10px 12px; border-radius: 0px; spacing: 12px; cursor: pointer; }
element normal.normal    { text-color: @text; }
element alternate.normal { text-color: @text; }

element selected.normal {
    background-color: @surface1;
    text-color:       @text;
    border:           0px;
}

element-icon { size: 22px; vertical-align: 0.5; }
element-text { vertical-align: 0.5; highlight: bold; }
message { background-color: @surface0; border-radius: 0px; padding: 10px; }
